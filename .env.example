# ---- agent/brain.py ----
OPENROUTER_API_KEY=
ROUTER_MODEL=deepseek/deepseek-v4.1-flash
FILTER_MODEL=deepseek/deepseek-v4.1-flash
WORKER_MODEL=deepseek/deepseek-v4-pro
SPEND_CAP=15.0

AGENT_REPO=your-name/superagent-demo-app      # the demo-app, pushed to its own repo
AGENT_GH_TOKEN=                               # fine-grained token, scoped to that one repo
GH_TEAM=your-github-login                     # comma-separated logins allowed to follow up on GitHub

BUG_UI_URL=http://localhost:3000              # or https://your-bug-ui.vercel.app
BUG_UI_TOKEN=                                 # shared secret, must match bug-ui/.env's BUG_UI_TOKEN

AXIOM_WEBHOOK_TOKEN=                           # shared secret you also put in Axiom's webhook headers

TELEGRAM_TOKEN=                                # optional; leave blank to skip Telegram entirely
ALLOWED_TELEGRAM=                              # comma-separated usernames; EMPTY MEANS ANYONE CAN REPORT

ADMIN_SECRET=                                  # protects GET /events
STATE_PATH=agent/state.json
WORK_ROOT=agent/work

# ---- bug-ui/.env.local ----
# BRAIN_URL=http://localhost:8000
# BUG_UI_TOKEN=                                # same value as above

# ---- demo-app/.env (optional; only if you want real Axiom logging while running it) ----
# AXIOM_TOKEN=
# AXIOM_DATASET=
